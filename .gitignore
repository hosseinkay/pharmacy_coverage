# Secrets — never commit
.env

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Virtual environment
.venv/

# ---------------------------------------------------------------------------
# OSM / network cache — large binary blobs, NOT committed.
#
# IMPORTANT: gitignore negation only works when the parent directory is not
# itself excluded. Using `.cache/*` (contents) instead of `.cache/` (dir)
# lets git descend and honour the !-rules for individual files.
# ---------------------------------------------------------------------------
.cache/*

# Small, static Chicago reference files committed so Streamlit Cloud never
# needs to call external APIs on a cold start (< 10 MB total).
!.cache/chicago/
.cache/chicago/*
!.cache/chicago/acs_need_factors.parquet
!.cache/chicago/acs_tract_data.parquet
!.cache/chicago/census_blocks.parquet
!.cache/chicago/community_areas.parquet
!.cache/chicago/opportunity_zone_tracts.parquet

!.cache/chicago-illinois-usa/
.cache/chicago-illinois-usa/*
!.cache/chicago-illinois-usa/zoned_land.parquet
# Pre-computed street-network isochrone for existing pharmacies (read-only,
# generated once — regenerate with scripts/precompute_isochrone.py).
!.cache/chicago-illinois-usa/existing_isochrone_r0.50.parquet
# Per-N merged isochrones for the default demo candidates (N=01..10).
# One file per number of selected sites — mirrors the green existing-pharmacy
# isochrone pattern exactly.  Generated by scripts/precompute_n_isochrones.py.
!.cache/chicago-illinois-usa/new_sites_iso_n01_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n02_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n03_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n04_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n05_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n06_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n07_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n08_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n09_r0.50.parquet
!.cache/chicago-illinois-usa/new_sites_iso_n10_r0.50.parquet
# Full drive network (38 MB) — local precompute only.
!.cache/chicago-illinois-usa/drive_network.graphml
